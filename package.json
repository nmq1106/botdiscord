{
  "name": "bot_discord",
  "version": "2.0.0",
  "description": "Discord Game Bot with Web Management",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "bot": "node bot.js",
    "server": "node server.js",
    "dev": "concurrently \"nodemon bot.js\" \"nodemon server.js\"",
    "dev:bot": "nodemon bot.js",
    "dev:server": "nodemon server.js",
    "watch": "nodemon --watch . --ext js,json --ignore node_modules bot.js",
    "watch:all": "concurrently \"nodemon --watch . --ext js,json --ignore node_modules bot.js\" \"nodemon --watch . --ext js,json --ignore node_modules server.js\""
  },
  "keywords": [
    "discord",
    "bot",
    "game",
    "management"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.19.0",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "node-fetch": "^3.3.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}